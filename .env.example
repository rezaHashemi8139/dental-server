# Copy to .env and fill in. In production set these as real environment variables.

# Address to listen on.
ADDR=:8080

# PostgreSQL connection string.
DATABASE_URL=postgres://dental:CHANGE_ME@localhost:5432/dental?sslmode=disable

# TLS certificate and key. Leave empty in development; required in production.
TLS_CERT_FILE=
TLS_KEY_FILE=
