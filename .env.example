# Copy to .env and fill in. In production set these as real environment variables.
# scripts/dev.ps1 creates .env from this file and fills in the two keys automatically.

# Address to listen on.
ADDR=:8080

# Local development database (PostgreSQL 18 on this machine). These values are for
# local development only; production uses different credentials that never go in git.
#
# To connect with a database client (pgAdmin, DBeaver, psql...):
#   Host:     localhost
#   Port:     5432
#   Database: dental        (tests: dental_test)
#   User:     dental
#   Password: r9dFzWkahvDCwKeG33XNcoi9gmqBDiHp
#
# The PostgreSQL superuser (postgres) is only needed for administration; its
# password is not kept in the project.
DATABASE_URL=postgres://dental:r9dFzWkahvDCwKeG33XNcoi9gmqBDiHp@localhost:5432/dental?sslmode=disable

# Separate, empty database for the integration tests (internal/service). Leave empty to skip them.
TEST_DATABASE_URL=postgres://dental:r9dFzWkahvDCwKeG33XNcoi9gmqBDiHp@localhost:5432/dental_test?sslmode=disable

# 32 random bytes in base64 each. Generate one with:
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 32
# KEY_ENCRYPTION_KEY encrypts the local-database keys stored in PostgreSQL: if it changes or is lost,
# those keys can no longer be decrypted. SIGNING_KEY signs offline grants. ADMIN_TOKEN_KEY signs the admin
# panel's session tokens (JWT); changing it logs every administrator out. Use different values per environment.
KEY_ENCRYPTION_KEY=
SIGNING_KEY=
ADMIN_TOKEN_KEY=

# How long a login session lasts (Go duration: 30m, 12h, ...). Default 12h.
SESSION_TTL=12h

# TLS certificate and key. Leave empty in development; required in production.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Folder with the desktop app release on offer: release.json + the installer, as written by
# `pnpm build` in the desktop repository (its build/update folder). Default: updates (next to
# the binary). Replacing the files is picked up without a restart. Raise "minimumVersion" in
# release.json to force older apps to update before they keep working (see internal/releases).
UPDATES_DIR=updates
